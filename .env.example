# Copie este arquivo para .env.local e preencha os valores reais.
# Nenhuma dessas variáveis é obrigatória para rodar o site em dev —
# os recursos correspondentes simplesmente ficam desativados até serem
# configuradas.

# Google Tag / Google Analytics (Consent Mode) — carregado somente
# após consentimento de cookies analíticos no CookieBanner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel — carregado somente após consentimento de cookies de
# marketing no CookieBanner.
NEXT_PUBLIC_META_PIXEL_ID=

# Provedor de e-mail para o formulário de contato (app/api/contact/route.ts).
# Exemplo de integração com a Resend (https://resend.com):
RESEND_API_KEY=
CONTACT_TO_EMAIL=
